{
  "name": "ibrahimasylla-com",
  "version": "1.0.0",
  "private": true,
  "description": "Personal site of Ibrahima Sylla, a static, bilingual, single-page Next.js application.",
  "author": "Ibrahima Sylla <isyll711@gmail.com>",
  "license": "UNLICENSED",
  "homepage": "https://www.ibrahimasylla.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isyll/ibrahimasylla.com.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx --yes serve out",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "fix": "biome check --write .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "typecheck": "tsc --noEmit",
    "spell": "cspell --no-progress --no-summary \"**/*.{ts,tsx,md,mdx,json,jsonc,yml,yaml,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run typecheck && biome check . && pnpm run spell && pnpm run lint:md && pnpm run test",
    "clean": "node -e \"for (const d of ['.next', 'out', 'coverage']) require('node:fs').rmSync(d, { recursive: true, force: true })\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.8",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-icons": "^16.33.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@cspell/dict-fr-fr": "^2.3.2",
    "@fontsource/newsreader": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "cspell": "^10.3.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
